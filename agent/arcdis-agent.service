[Unit]
Description=ARCDIS Security Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/arcdis-agent
ExecStart=/opt/arcdis-agent/venv/bin/python /opt/arcdis-agent/agent.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=arcdis-agent

[Install]
WantedBy=multi-user.target
